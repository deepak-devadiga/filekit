{
  "name": "filekit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:ghpages": "ng build --configuration production --base-href /filekit/",
    "build:stats": "ng build --configuration production --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "deploy": "ng deploy --base-href=/filekit/",
    "deploy:dry": "ng deploy --base-href=/filekit/ --dry-run",
    "clean": "rm -rf dist .angular"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "js-yaml": "^5.5.0",
    "prettier-plugin-java": "^2.11.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/js-yaml": "^4.0.9",
    "angular-cli-ghpages": "^3.1.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
