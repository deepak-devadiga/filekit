{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FileKit: Start Dev Server",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "FileKit: Build Production",
      "type": "npm",
      "script": "build:prod",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "FileKit: Deploy to GitHub Pages",
      "type": "npm",
      "script": "deploy",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "FileKit: Deploy Dry Run (Test Deploy)",
      "type": "npm",
      "script": "deploy:dry",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "FileKit: Clean Cache & Dist",
      "type": "npm",
      "script": "clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "Always",
        "panel": "shared"
      }
    }
  ]
}
